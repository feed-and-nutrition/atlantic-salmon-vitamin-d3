#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'Human_CYP24A1'
[2] 'Mouse_Cyp24a1'
[3] 'Zebrafish_cyp24a1'
[4] 'Salmon_cyp24a1.a'
[5] 'Salmon_cyp24a1.b'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=9;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 4,
	100	 5,
	99	 4 5,
	100	 1 2,
	100	 1,
	1	 3 4,
	0	 3 5,
;
END; [Splits]

