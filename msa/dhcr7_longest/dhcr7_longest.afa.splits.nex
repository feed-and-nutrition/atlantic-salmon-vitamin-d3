#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'Zebrafish_dhcr7'
[2] 'Salmon_dhcr7.a'
[3] 'Salmon_dhcr7.b'
[4] 'Human_DHCR7'
[5] 'Mouse_Dhcr7'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=7;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 2 3,
	100	 4,
	100	 5,
	100	 4 5,
	100	 1,
;
END; [Splits]

