#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'Human_CYP27B1'
[2] 'Mouse_Cyp27b1'
[3] 'Zebrafish_cyp27b1'
[4] 'Salmon_cyp27b1.a'
[5] 'Salmon_cyp27b1.b'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=7;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 4,
	100	 5,
	100	 4 5,
	100	 1 2,
	100	 1,
;
END; [Splits]

