#nexus

BEGIN Taxa;
DIMENSIONS ntax=6;
TAXLABELS
[1] 'Zebrafish_dhcr7'
[2] 'Salmon_dhcr7.a'
[3] 'Salmon_dhcr7.b.1'
[4] 'Salmon_dhcr7.b.2'
[5] 'Human_DHCR7'
[6] 'Mouse_Dhcr7'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=6 nsplits=11;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 4,
	80	 3 4,
	100	 1 5 6,
	100	 5,
	100	 6,
	100	 5 6,
	100	 1,
	11	 2 3,
	9	 2 4,
;
END; [Splits]

